// clusterlight.comp.hlsl
#define NUM_LIGHTS 64
#define CLUSTER_SIZE_X 8
#define CLUSTER_SIZE_Y 8
#define CLUSTER_SIZE_Z 8
#define TOTAL_CLUSTERS CLUSTER_SIZE_X * CLUSTER_SIZE_Y * CLUSTER_SIZE_Z
#define LIGHT_INDEX_LIST_SIZE (NUM_LIGHTS * TOTAL_CLUSTERS)

struct Light {
    float4 position;
    float4 colorAndRadius;
    float4 direction;
    float4 cutOff;
};

struct Cluster {
    uint counts;
    uint offsets;
    float2 padding;
};

struct ClusterIndexList {
    struct Indices {
        uint clusterIndexList; // 4 字节
        float padding[3];      // 12 字节，确保 16 字节对齐
    };
    Indices indices[LIGHT_INDEX_LIST_SIZE]; // 全局光源索引列表
};

struct UBO {
    float4x4 projection;
    float4x4 model;
    float4x4 view;
    float3 camPos;
    uint maxlightindexnum;
};

// 全局计数器，用于原子操作
struct GlobalCounter {
    uint counter;
    uint padding[3];
};

// 绑定资源
[[vk::binding(0, 0)]] RWStructuredBuffer<GlobalCounter> globalCounter : register(u0);
[[vk::binding(1, 0)]] StructuredBuffer<Light> lights : register(t1);
[[vk::binding(2, 0)]] RWStructuredBuffer<Cluster> clusterData : register(u2);
[[vk::binding(3, 0)]] RWStructuredBuffer<ClusterIndexList::Indices> clusterIndexList : register(u3);
[[vk::binding(4, 0)]] ConstantBuffer<UBO> ubo : register(b4);

// 计算光源的AABB包围盒
void calculateLightBounds(uint lightIdx, inout float3 minBounds, inout float3 maxBounds) {
    float3 lightPos = lights[lightIdx].position.xyz;
    float lightRadius = lights[lightIdx].colorAndRadius.w;
    
    minBounds = lightPos - float3(lightRadius, lightRadius, lightRadius);
    maxBounds = lightPos + float3(lightRadius, lightRadius, lightRadius);
}

// 将世界空间坐标转换为视图空间
float3 worldToView(float3 worldPos) {
    return mul(ubo.view, float4(worldPos, 1.0)).xyz;
}

// 将视图空间坐标转换为裁剪空间
float4 viewToClip(float3 viewPos) {
    return mul(ubo.projection, float4(viewPos, 1.0));
}

// 将裁剪空间坐标转换为NDC空间
float3 clipToNDC(float4 clipPos) {
    return clipPos.xyz / clipPos.w;
}

// 将NDC坐标转换为屏幕空间
float2 ndcToScreen(float3 ndcPos) {
    return ndcPos.xy * 0.5 + 0.5;
}

// 计算深度集群索引
uint calculateDepthClusterIndex(float viewZ) {
    float zNear = 0.1;
    float zFar = 256.0;
    float normalizedZ = (log(viewZ / zNear) / log(zFar / zNear));
    return clamp(uint(normalizedZ * float(CLUSTER_SIZE_Z)), 0u, CLUSTER_SIZE_Z - 1);
}

// 计算集群索引
uint calculateClusterIndex(uint x, uint y, uint z) {
    return z * CLUSTER_SIZE_X * CLUSTER_SIZE_Y + y * CLUSTER_SIZE_X + x;
}

// 检查光源是否与集群相交
bool lightIntersectsCluster(uint lightIdx, uint clusterX, uint clusterY, uint clusterZ) {
    // 获取光源位置和半径
    float3 lightPos = lights[lightIdx].position.xyz;
    float lightRadius = lights[lightIdx].colorAndRadius.w;

    // 计算集群在屏幕空间的边界（放宽条件）
    float minX = float(clusterX) / float(CLUSTER_SIZE_X);
    float maxX = float(clusterX + 1) / float(CLUSTER_SIZE_X);
    float minY = float(clusterY) / float(CLUSTER_SIZE_Y);
    float maxY = float(clusterY + 1) / float(CLUSTER_SIZE_Y);

    // 将屏幕空间映射到NDC空间 [0,1] -> [-1,1]
    minX = minX * 2.0 - 1.0;
    maxX = maxX * 2.0 - 1.0;
    minY = minY * 2.0 - 1.0;
    maxY = maxY * 2.0 - 1.0;

    // 计算深度范围（放宽深度方向的判定）
    float zNear = 0.1;
    float zFar = 256.0;
    float minZ = zNear * pow(zFar / zNear, float(clusterZ) / float(CLUSTER_SIZE_Z));
    float maxZ = zNear * pow(zFar / zNear, float(clusterZ + 1) / float(CLUSTER_SIZE_Z));

    // 创建视图空间中的8个角点
    float3 corners[8] = {
        float3(minX, minY, -minZ), // 近平面左下
        float3(maxX, minY, -minZ), // 近平面右下
        float3(minX, maxY, -minZ), // 近平面左上
        float3(maxX, maxY, -minZ), // 近平面右上
        float3(minX, minY, -maxZ), // 远平面左下
        float3(maxX, minY, -maxZ), // 远平面右下
        float3(minX, maxY, -maxZ), // 远平面左上
        float3(maxX, maxY, -maxZ)  // 远平面右上
    };

    // 将视图空间角点转换为世界空间
    float4x4 invView = transpose(ubo.view); // 简化逆矩阵计算
    float3 worldCorners[8];
    for (int i = 0; i < 8; i++) {
        float4 worldPos = mul(invView, float4(corners[i], 1.0));
        worldCorners[i] = worldPos.xyz / worldPos.w;
    }

    // 计算集群的AABB包围盒
    float3 clusterMin = worldCorners[0];
    float3 clusterMax = worldCorners[0];
    for (int i = 1; i < 8; i++) {
        clusterMin = min(clusterMin, worldCorners[i]);
        clusterMax = max(clusterMax, worldCorners[i]);
    }

    // 计算光源的AABB包围盒
    float3 lightMin = lightPos - float3(lightRadius, lightRadius, lightRadius);
    float3 lightMax = lightPos + float3(lightRadius, lightRadius, lightRadius);

    // 改进的相交检测：放宽条件以确保光源覆盖整个区域
    float3 clusterCenter = (clusterMin + clusterMax) * 0.5;
    float3 clusterExtents = (clusterMax - clusterMin) * 0.5;
    float3 lightCenter = lightPos;
    float3 lightExtents = float3(lightRadius, lightRadius, lightRadius);
    
    float3 delta = abs(clusterCenter - lightCenter);
    float3 totalExtents = clusterExtents + lightExtents;
    
    return all(delta <= totalExtents * 2.0); // 放宽2.0倍以确保更多光源被包含
}

// 主计算着色器
[numthreads(NUM_LIGHTS, 1, 1)]
void main(uint3 DTid : SV_DispatchThreadID) {
    uint lightIdx = DTid.x;
    if (lightIdx >= NUM_LIGHTS) return;

    // 第一遍：计算每个集群的光源计数
    for (uint z = 0; z < CLUSTER_SIZE_Z; z++) {
        for (uint y = 0; y < CLUSTER_SIZE_Y; y++) {
            for (uint x = 0; x < CLUSTER_SIZE_X; x++) {
                uint clusterIdx = calculateClusterIndex(x, y, z);
                
                if (lightIntersectsCluster(lightIdx, x, y, z)) {
                    InterlockedAdd(clusterData[clusterIdx].counts, 1);
                }
            }
        }
    }

    // 内存屏障，确保所有计数更新完成
    AllMemoryBarrierWithGroupSync();

    // 第二遍：计算偏移（仅由第一个线程执行）
    if (lightIdx == 0) {
        uint runningOffset = 0;
        for (uint i = 0; i < TOTAL_CLUSTERS; i++) {
            uint count = clusterData[i].counts;
            clusterData[i].offsets = runningOffset;
            runningOffset += count;
        }
        globalCounter[0].counter = runningOffset; // 可选，用于调试
    }

    // 内存屏障，确保偏移计算完成
    AllMemoryBarrierWithGroupSync();

    // 第三遍：填充光源索引列表
    for (uint z = 0; z < CLUSTER_SIZE_Z; z++) {
        for (uint y = 0; y < CLUSTER_SIZE_Y; y++) {
            for (uint x = 0; x < CLUSTER_SIZE_X; x++) {
                uint clusterIdx = calculateClusterIndex(x, y, z);
                
                if (lightIntersectsCluster(lightIdx, x, y, z)) {
                    uint index;
                    InterlockedAdd(clusterData[clusterIdx].counts, -1, index); // 使用counts作为剩余槽位计数器
                    uint offset = clusterData[clusterIdx].offsets + index; // 直接使用原子操作返回的索引
                    if (offset < LIGHT_INDEX_LIST_SIZE) { // 确保不超出缓冲区范围
                        clusterIndexList[offset].clusterIndexList = lightIdx;
                    }
                }
            }
        }
    }
}