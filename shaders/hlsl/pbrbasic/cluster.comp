#define NUM_LIGHTS 16
#define CLUSTER_SIZE_X 4
#define CLUSTER_SIZE_Y 4
#define CLUSTER_SIZE_Z 4
#define TOTAL_CLUSTERS (CLUSTER_SIZE_X * CLUSTER_SIZE_Y * CLUSTER_SIZE_Z)
#define LIGHT_INDEX_LIST_SIZE (NUM_LIGHTS * TOTAL_CLUSTERS)

struct Light {
    float4 position;
    float4 colorAndRadius;
    float4 direction;
    float4 cutOff;
};

struct Cluster {
    uint counts;
    uint offsets;
    float2 padding;
};

struct ClusterIndexList {
    uint clusterIndexList;
    float padding1;
    float padding2;
    float padding3;
};

struct UBO {
    float4x4 projection;
    float4x4 model;
    float4x4 view;
    float3 camPos;
    uint maxlightindexnum;
};

cbuffer ubo : register(b0) {
    UBO ubo;
};

StructuredBuffer<Light> lights : register(t0);
RWStructuredBuffer<Cluster> clusterCountsandOffsets : register(u0);
RWStructuredBuffer<ClusterIndexList> clusterIndexList : register(u1);
RWBuffer<uint> globalCounter : register(u2);

groupshared uint sharedClusterCounts[TOTAL_CLUSTERS];

#define WORKGROUP_SIZE_X 4
#define WORKGROUP_SIZE_Y 4
#define WORKGROUP_SIZE_Z 1
#define TOTAL_THREADS (WORKGROUP_SIZE_X * WORKGROUP_SIZE_Y * WORKGROUP_SIZE_Z)

[numthreads(WORKGROUP_SIZE_X, WORKGROUP_SIZE_Y, WORKGROUP_SIZE_Z)]
void main(uint3 groupId : SV_GroupID, uint3 threadId : SV_GroupThreadID, uint3 dispatchId : SV_DispatchThreadID) {
    // 计算线程索引，用于并行初始化
    uint threadIdx = threadId.x + threadId.y * WORKGROUP_SIZE_X + threadId.z * WORKGROUP_SIZE_X * WORKGROUP_SIZE_Y;
    
    // 严格的边界检查
    if (groupId.x >= NUM_LIGHTS) return;
    
    // 并行初始化共享内存，每个线程负责一部分
    for (uint i = threadIdx; i < TOTAL_CLUSTERS; i += TOTAL_THREADS) {
        sharedClusterCounts[i] = 0;
    }
    
    // 确保所有线程完成初始化
    GroupMemoryBarrierWithGroupSync();
    
    // 重置全局计数器（只在第一个工作组的第一个线程执行）
    if (groupId.x == 0 && threadIdx == 0) {
        globalCounter[0] = 0;
    }
    
    // 确保全局计数器重置完成
    DeviceMemoryBarrierWithGroupSync();

    uint lightIdx = groupId.x;
    if (lightIdx >= NUM_LIGHTS) return;

    // 安全地读取光源数据
    Light light;
    if (lightIdx < NUM_LIGHTS) {
        light = lights[lightIdx];
    } else {
        // 如果索引无效，使用默认值
        light.position = float4(0, 0, 0, 1);
        light.colorAndRadius = float4(0, 0, 0, 0);
        light.direction = float4(0, 0, 0, 0);
        light.cutOff = float4(0, 0, 0, 0);
        return;
    }
    
    float radius = light.colorAndRadius.w;

    float4x4 viewProj = mul(ubo.projection, ubo.view);
    float4 clipPos = mul(viewProj, light.position);
    float ndcX = clipPos.x / clipPos.w;
    float ndcY = clipPos.y / clipPos.w;
    float ndcZ = clipPos.z / clipPos.w;
    float radiusNDC = radius / clipPos.w;

    float zNear = 0.1;
    float zFar = 256.0;
    float minX = clamp(ndcX - radiusNDC, -1.0, 1.0);
    float maxX = clamp(ndcX + radiusNDC, -1.0, 1.0);
    float minY = clamp(ndcY - radiusNDC, -1.0, 1.0);
    float maxY = clamp(ndcY + radiusNDC, -1.0, 1.0);
    float minZ = clamp(ndcZ - radiusNDC, 0.0, 1.0);
    float maxZ = clamp(ndcZ + radiusNDC, 0.0, 1.0);

    uint minClusterX = uint((minX * 0.5 + 0.5) * CLUSTER_SIZE_X);
    uint maxClusterX = uint((maxX * 0.5 + 0.5) * CLUSTER_SIZE_X);
    uint minClusterY = uint((minY * 0.5 + 0.5) * CLUSTER_SIZE_Y);
    uint maxClusterY = uint((maxY * 0.5 + 0.5) * CLUSTER_SIZE_Y);
    uint minClusterZ = uint((log(max(0.0001, minZ) * (zFar - zNear) + zNear) / log(zFar / zNear)) * CLUSTER_SIZE_Z);
    uint maxClusterZ = uint((log(max(0.0001, maxZ) * (zFar - zNear) + zNear) / log(zFar / zNear)) * CLUSTER_SIZE_Z);

    minClusterX = clamp(minClusterX, 0u, CLUSTER_SIZE_X - 1);
    maxClusterX = clamp(maxClusterX, 0u, CLUSTER_SIZE_X - 1);
    minClusterY = clamp(minClusterY, 0u, CLUSTER_SIZE_Y - 1);
    maxClusterY = clamp(maxClusterY, 0u, CLUSTER_SIZE_Y - 1);
    minClusterZ = clamp(minClusterZ, 0u, CLUSTER_SIZE_Z - 1);
    maxClusterZ = clamp(maxClusterZ, 0u, CLUSTER_SIZE_Z - 1);

    // 声明并初始化 clusterCountX 变量
    uint clusterCountX = maxClusterX - minClusterX + 1;
    uint clusterCountY = maxClusterY - minClusterY + 1;
    uint clusterCountZ = maxClusterZ - minClusterZ + 1;
    uint totalClusters = clusterCountX * clusterCountY * clusterCountZ;

    for (uint i = threadIdx; i < totalClusters; i += TOTAL_THREADS) {
        uint z = i / (clusterCountX * clusterCountY);
        uint y = (i / clusterCountX) % clusterCountY;
        uint x = i % clusterCountX;
        z += minClusterZ;
        y += minClusterY;
        x += minClusterX;

        uint clusterIdx = z * CLUSTER_SIZE_X * CLUSTER_SIZE_Y + y * CLUSTER_SIZE_X + x;
        if (clusterIdx < TOTAL_CLUSTERS) {
            InterlockedAdd(sharedClusterCounts[clusterIdx], 1);
        }
    }
    GroupMemoryBarrierWithGroupSync();

    if (threadIdx == 0) {
        uint runningSum = 0;
        
        // 使用原子操作安全地读取全局计数器
        InterlockedAdd(globalCounter[0], 0, runningSum);
        
        // 严格检查是否超出最大灯光索引数量
        uint maxLightIndexNum = min(ubo.maxlightindexnum, LIGHT_INDEX_LIST_SIZE);
        
        // 确保全局计数器不超过最大值
        if (runningSum > maxLightIndexNum) {
            // 如果已经超出范围，重置计数器
            InterlockedExchange(globalCounter[0], 0, runningSum);
            runningSum = 0;
        }
        
        for (uint i = 0; i < TOTAL_CLUSTERS; i++) {
            // 安全地读取共享内存中的计数
            uint clusterCount = sharedClusterCounts[i];
            
            if (clusterCount > 0) {
                // 确保不会超出最大灯光索引数量，使用安全的算术
                uint remainingSpace = 0;
                if (maxLightIndexNum > runningSum) {
                    remainingSpace = maxLightIndexNum - runningSum;
                }
                
                uint safeCount = min(clusterCount, remainingSpace);
                
                if (safeCount > 0) {
                    // 原子操作更新全局计数器，带错误检查
                    uint oldValue;
                    InterlockedAdd(globalCounter[0], safeCount, oldValue);
                    
                    // 验证全局计数器是否在有效范围内
                    uint newTotal = oldValue + safeCount;
                    if (newTotal <= maxLightIndexNum) {
                        // 安全地更新集群数据
                        clusterCountsandOffsets[i].counts = safeCount;
                        clusterCountsandOffsets[i].offsets = runningSum;
                        runningSum += safeCount;
                    } else {
                        // 如果超出范围，回滚全局计数器并设置为0
                        InterlockedAdd(globalCounter[0], (uint)(-safeCount));
                        clusterCountsandOffsets[i].counts = 0;
                        clusterCountsandOffsets[i].offsets = runningSum;
                    }
                } else {
                    // 如果没有足够空间，则设置为0
                    clusterCountsandOffsets[i].counts = 0;
                    clusterCountsandOffsets[i].offsets = runningSum;
                }
            } else {
                // 集群中没有灯光
                clusterCountsandOffsets[i].counts = 0;
                clusterCountsandOffsets[i].offsets = runningSum;
            }
            
            // 每次更新后添加内存屏障，确保写入对其他线程可见
            DeviceMemoryBarrier();
        }
        
        // 确保所有写入对其他线程可见
        DeviceMemoryBarrierWithGroupSync();
    }
    GroupMemoryBarrierWithGroupSync();

    // 添加全局内存屏障，确保前面的操作完成
    DeviceMemoryBarrierWithGroupSync();
    
    for (uint i = threadIdx; i < totalClusters; i += TOTAL_THREADS) {
        uint z = i / (clusterCountX * clusterCountY);
        uint y = (i / clusterCountX) % clusterCountY;
        uint x = i % clusterCountX;
        z += minClusterZ;
        y += minClusterY;
        x += minClusterX;

        // 严格的边界检查
        if (x >= CLUSTER_SIZE_X || y >= CLUSTER_SIZE_Y || z >= CLUSTER_SIZE_Z) {
            continue;
        }

        uint clusterIdx = z * CLUSTER_SIZE_X * CLUSTER_SIZE_Y + y * CLUSTER_SIZE_X + x;
        
        // 多重边界检查
        if (clusterIdx < TOTAL_CLUSTERS && 
            sharedClusterCounts[clusterIdx] > 0 && 
            clusterCountsandOffsets[clusterIdx].counts > 0) {
            
            uint offset;
            // 原子操作获取偏移量
            InterlockedAdd(clusterCountsandOffsets[clusterIdx].counts, -1, offset);
            
            // 确保偏移量计算正确
            if (offset > 0) {
                uint baseOffset = clusterCountsandOffsets[clusterIdx].offsets;
                
                // 防止整数溢出
                if (baseOffset <= 0xFFFFFFFF - offset) {
                    offset = baseOffset + offset - 1;
                    
                    // 严格的边界检查，确保不会越界访问
                    if (offset < ubo.maxlightindexnum && 
                        offset < LIGHT_INDEX_LIST_SIZE && 
                        lightIdx < NUM_LIGHTS) {
                        
                        // 使用原子操作确保写入安全
                        uint oldValue;
                        InterlockedExchange(clusterIndexList[offset].clusterIndexList, lightIdx, oldValue);
                        
                        // 内存屏障确保写入对其他线程可见
                        DeviceMemoryBarrier();
                    }
                }
            }
        }
    }
    
    // 最终内存屏障，确保所有写入完成
    DeviceMemoryBarrierWithGroupSync();
}