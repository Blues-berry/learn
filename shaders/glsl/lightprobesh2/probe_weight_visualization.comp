#version 450
#extension GL_ARB_separate_shader_objects : enable

// 工作组大小：16x16 处理高分辨率立方体贴图
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// 探针数据结构
struct ProbeData {
    vec4 position;      // 探针位置 (xyz, padding)
    vec4 reserved;      // 保留用于对齐
};

// 常量缓冲区：探针信息
layout(set = 0, binding = 0) uniform ProbeBuffer {
    uint probeCount;
    uint maxDistance;
    uint visualizationMode;  // 0=单个探针权重, 1=权重热力图, 2=最近探针ID
    uint padding;
    ProbeData probes[256];   // 最多支持256个探针
} probeBuffer;

// 输出：权重可视化立方体贴图
layout(set = 0, binding = 1, rgba16f) uniform imageCube outputCubemap;

// 立方体贴图面的法向量
const vec3 cubeFaceNormals[6] = vec3[](
    vec3(1.0, 0.0, 0.0),   // +X
    vec3(-1.0, 0.0, 0.0),  // -X
    vec3(0.0, 1.0, 0.0),   // +Y
    vec3(0.0, -1.0, 0.0),  // -Y
    vec3(0.0, 0.0, 1.0),   // +Z
    vec3(0.0, 0.0, -1.0)   // -Z
);

// 计算两点之间的距离
float Distance(vec3 a, vec3 b) {
    return length(a - b);
}

// 将权重转换为颜色（热力图）
vec3 WeightToColor(float weight) {
    // 使用热力图：蓝色 -> 绿色 -> 黄色 -> 红色
    if (weight < 0.25) {
        // 蓝色到绿色
        float t = weight / 0.25;
        return mix(vec3(0.0, 0.0, 1.0), vec3(0.0, 1.0, 0.0), t);
    } else if (weight < 0.5) {
        // 绿色到黄色
        float t = (weight - 0.25) / 0.25;
        return mix(vec3(0.0, 1.0, 0.0), vec3(1.0, 1.0, 0.0), t);
    } else if (weight < 0.75) {
        // 黄色到橙色
        float t = (weight - 0.5) / 0.25;
        return mix(vec3(1.0, 1.0, 0.0), vec3(1.0, 0.5, 0.0), t);
    } else {
        // 橙色到红色
        float t = (weight - 0.75) / 0.25;
        return mix(vec3(1.0, 0.5, 0.0), vec3(1.0, 0.0, 0.0), t);
    }
}

// 将探针ID转换为颜色
vec3 ProbeIDToColor(uint probeID) {
    // 使用伪随机颜色
    float r = fract(sin(float(probeID) * 12.9898) * 43758.5453);
    float g = fract(sin(float(probeID) * 78.233) * 43758.5453);
    float b = fract(sin(float(probeID) * 45.164) * 43758.5453);
    return vec3(r, g, b);
}

// 计算单个探针的权重
float ComputeProbeWeight(vec3 queryPos, uint probeIdx) {
    vec3 probePos = probeBuffer.probes[probeIdx].position.xyz;
    float dist = Distance(queryPos, probePos);
    
    // 如果距离超过最大距离，权重为0
    if (dist > float(probeBuffer.maxDistance)) {
        return 0.0;
    }
    
    // 使用反距离加权（IDW）
    const float epsilon = 0.01;
    return 1.0 / (dist + epsilon);
}

// 计算所有探针的权重
vec4 VisualizeWeights(vec3 queryPos, vec3 direction) {
    // 计算所有探针的权重
    float weights[256];
    float totalWeight = 0.0;
    
    for (uint i = 0; i < probeBuffer.probeCount; ++i) {
        weights[i] = ComputeProbeWeight(queryPos, i);
        totalWeight += weights[i];
    }
    
    // 归一化权重
    if (totalWeight > 0.0) {
        for (uint i = 0; i < probeBuffer.probeCount; ++i) {
            weights[i] /= totalWeight;
        }
    }
    
    vec3 color = vec3(0.0);
    
    if (probeBuffer.visualizationMode == 0u) {
        // 模式0：显示第一个探针的权重
        if (probeBuffer.probeCount > 0) {
            float weight = weights[0];
            color = WeightToColor(weight);
        }
    } else if (probeBuffer.visualizationMode == 1u) {
        // 模式1：权重热力图（所有探针权重之和）
        float maxWeight = 0.0;
        for (uint i = 0; i < probeBuffer.probeCount; ++i) {
            maxWeight = max(maxWeight, weights[i]);
        }
        color = WeightToColor(maxWeight);
    } else if (probeBuffer.visualizationMode == 2u) {
        // 模式2：显示最近探针的ID
        float maxWeight = 0.0;
        uint closestProbe = 0;
        for (uint i = 0; i < probeBuffer.probeCount; ++i) {
            if (weights[i] > maxWeight) {
                maxWeight = weights[i];
                closestProbe = i;
            }
        }
        color = ProbeIDToColor(closestProbe);
    }
    
    return vec4(color, 1.0);
}

void main() {
    // 获取输出立方体贴图的尺寸
    ivec2 outputSize = imageSize(outputCubemap).xy;
    
    // 确保当前线程在有效范围内
    if (gl_GlobalInvocationID.x >= outputSize.x || gl_GlobalInvocationID.y >= outputSize.y) {
        return;
    }
    
    // 处理立方体贴图的6个面
    for (uint face = 0; face < 6; ++face) {
        // 计算像素坐标
        ivec3 texel = ivec3(gl_GlobalInvocationID.xy, face);
        vec2 uv = vec2(gl_GlobalInvocationID.xy) / vec2(outputSize);
        
        // 计算立方体贴图采样方向
        vec3 normal = cubeFaceNormals[face];
        vec3 up = abs(normal.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
        vec3 right = normalize(cross(up, normal));
        up = cross(normal, right);
        
        vec2 scaledUV = uv * 2.0 - 1.0;  // 映射到 [-1, 1]
        vec3 direction = normalize(normal + scaledUV.x * right + scaledUV.y * up);
        
        // 查询位置
        vec3 queryPos = direction;
        
        // 可视化权重
        vec4 visualizedColor = VisualizeWeights(queryPos, direction);
        
        // 写入输出立方体贴图
        imageStore(outputCubemap, texel, visualizedColor);
    }
}

