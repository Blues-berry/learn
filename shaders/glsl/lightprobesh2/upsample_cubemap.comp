#version 450
#extension GL_ARB_separate_shader_objects : enable

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform samplerCube lowResCubemap;
layout(set = 0, binding = 1, rgba8) uniform imageCube highResCubemap;

const vec3 cubeFaceNormals[6] = vec3[](
    vec3(1.0, 0.0, 0.0),   // +X
    vec3(-1.0, 0.0, 0.0),  // -X
    vec3(0.0, 1.0, 0.0),   // +Y
    vec3(0.0, -1.0, 0.0),  // -Y
    vec3(0.0, 0.0, 1.0),   // +Z
    vec3(0.0, 0.0, -1.0)   // -Z
);

void main() {
    // 获取高分辨率贴图的尺寸
    ivec2 highResSize = imageSize(highResCubemap).xy;
    // 确保当前线程在有效范围内
    if (gl_GlobalInvocationID.x >= highResSize.x || gl_GlobalInvocationID.y >= highResSize.y) {
        return;
    }

    // 循环处理 6 个立方体面
    for (uint face = 0; face < 6; ++face) {
        // 计算像素坐标和层
        ivec3 texel = ivec3(gl_GlobalInvocationID.xy, face);
        vec2 uv = vec2(gl_GlobalInvocationID.xy) / vec2(highResSize);

        // 计算立方体贴图采样方向
        vec3 normal = cubeFaceNormals[face];
        vec3 up = abs(normal.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
        vec3 right = normalize(cross(up, normal));
        up = cross(normal, right);

        vec2 scaledUV = uv * 2.0 - 1.0; // 映射到 [-1, 1]
        vec3 direction = normalize(normal + scaledUV.x * right + scaledUV.y * up);

        // 从低分辨率立方体贴图采样
        vec4 color = textureLod(lowResCubemap, direction, 0.0);

        // 写入高分辨率立方体贴图
        imageStore(highResCubemap, texel, color);
    }
}