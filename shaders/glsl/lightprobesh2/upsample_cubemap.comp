#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform samplerCube lowResCubemap;
layout(set = 0, binding = 1, rgba8) uniform imageCube highResCubemap;

const vec3 cubeFaceNormals[6] = vec3[](
    vec3(1.0, 0.0, 0.0),   // +X
    vec3(-1.0, 0.0, 0.0),  // -X
    vec3(0.0, 1.0, 0.0),   // +Y
    vec3(0.0, -1.0, 0.0),  // -Y
    vec3(0.0, 0.0, 1.0),   // +Z
    vec3(0.0, 0.0, -1.0)   // -Z
);

void main() {
    ivec3 texel = ivec3(gl_GlobalInvocationID.xy, gl_Layer);
    vec2 uv = vec2(gl_GlobalInvocationID.xy) / vec2(imageSize(highResCubemap).xy);
    
    // 计算立方体贴图采样方向
    vec3 normal = cubeFaceNormals[gl_Layer];
    vec3 up = abs(normal.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
    vec3 right = normalize(cross(up, normal));
    up = cross(normal, right);
    
    vec2 scaledUV = uv * 2.0 - 1.0; // 映射到[-1, 1]
    vec3 direction = normalize(normal + scaledUV.x * right + scaledUV.y * up);
    
    // 从低分辨率cubemap采样
    vec4 color = textureLod(lowResCubemap, direction, 0.0);
    
    // 写入高分辨率cubemap
    imageStore(highResCubemap, texel, color);
}