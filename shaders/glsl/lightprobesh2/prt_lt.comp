#version 450

// Per-vertex Light Transport (LT) compute
// Each invocation computes SH transport coefficients for one vertex
// Bindings:
//  set=0,binding=0: SamplesBuffer (GPUSample[])
//  set=0,binding=1: LTInputBuffer (GPULTInput[])
//  set=0,binding=2: OutputCoefficients (GPUSHCoefficients[])

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

struct GPUSample {
    vec4 direction;  // xyz dir, w unused
    vec4 radiance;   // rgb radiance, w unused (not used here)
};

struct GPULTInput {
    vec4 position;   // xyz
    vec4 normal;     // xyz
    vec4 albedo;     // rgb
};

struct GPUSHCoefficients {
    vec4 coeffs[9];  // rgb in xyz
};

layout(set = 0, binding = 0) buffer SamplesBuffer { GPUSample samples[]; };
layout(set = 0, binding = 1) buffer LTInputBuffer { GPULTInput ltInputs[]; };
layout(set = 0, binding = 2) buffer OutputCoefficients { GPUSHCoefficients outCoeffs[]; };

// Match CPU EvaluateBasis
float shBasis(int i, vec3 d) {
    float x = d.x, y = d.y, z = d.z;
    if (i==0) return 0.282095f;                          // Y00
    if (i==1) return  0.488603f * y;                     // Y1-1
    if (i==2) return  0.488603f * z;                     // Y10
    if (i==3) return  0.488603f * x;                     // Y11
    if (i==4) return  1.092548f * x * y;                 // Y2-2
    if (i==5) return  1.092548f * y * z;                 // Y2-1
    if (i==6) return  0.315392f * (3.0f * z * z - 1.0f); // Y20
    if (i==7) return  1.092548f * x * z;                 // Y21
    if (i==8) return  0.546274f * (x * x - y * y);       // Y22
    return 0.0f;
}

void main() {
    uint vid = gl_GlobalInvocationID.x;
    GPULTInput vin = ltInputs[vid];
    vec3 n = normalize(vin.normal.xyz);
    vec3 albedo = vin.albedo.xyz;

    // zero output
    for (int i=0;i<9;i++) { outCoeffs[vid].coeffs[i] = vec4(0.0); }

    int N = int(samples.length());
    if (N <= 0) return;
    float w = 4.0 * 3.14159265 / float(N);

    for (int s=0; s<N; ++s) {
        vec3 dir = normalize(samples[s].direction.xyz);
        float cosine = max(0.0, dot(n, dir));
        for (int i=0;i<9;i++) {
            float b = shBasis(i, dir);
            outCoeffs[vid].coeffs[i].xyz += albedo * (cosine * b * w);
        }
    }
}

