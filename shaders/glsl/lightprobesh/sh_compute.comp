#version 450

// 球谐系数结构体
struct SHCoefficients {
    vec4 l00;    // 0阶
    vec4 l1m1;   // 1阶
    vec4 l10;    // 1阶
    vec4 l1p1;   // 1阶
    vec4 l2m2;   // 2阶
    vec4 l2m1;   // 2阶
    vec4 l20;    // 2阶
    vec4 l2p1;   // 2阶
    vec4 l2p2;   // 2阶
};

// 输入绑定
layout(set = 0, binding = 0) uniform samplerCube envMap;      // 环境贴图
layout(set = 0, binding = 1) buffer SHBuffer {                // 存储SH系数的缓冲区
    SHCoefficients shCoeffs;
};

// 工作组大小
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

// 球谐基函数
// 参考: https://cseweb.ucsd.edu/~ravir/papers/envmap/envmap.pdf
// 以及 LearnOpenGL 的实现

// 0阶 - 常数项
float shBasis00(vec3 dir) {
    return 0.282095f;
}

// 1阶 - 线性项
float shBasis1m1(vec3 dir) {
    return -0.488603f * dir.y;
}

float shBasis10(vec3 dir) {
    return 0.488603f * dir.z;
}

float shBasis1p1(vec3 dir) {
    return -0.488603f * dir.x;
}

// 2阶 - 二次项
float shBasis2m2(vec3 dir) {
    return 1.092548f * dir.x * dir.y;
}

float shBasis2m1(vec3 dir) {
    return -1.092548f * dir.y * dir.z;
}

float shBasis20(vec3 dir) {
    return 0.315392f * (3.0f * dir.z * dir.z - 1.0f);
}

float shBasis2p1(vec3 dir) {
    return -1.092548f * dir.x * dir.z;
}

float shBasis2p2(vec3 dir) {
    return 0.546274f * (dir.x * dir.x - dir.y * dir.y);
}

// 蒙特卡洛积分生成球谐系数
void main() {
    // 采样数
    const int numSamples = 1024;

    // 初始化所有SH系数为0
    shCoeffs.l00 = vec4(0.0);
    shCoeffs.l1m1 = vec4(0.0);
    shCoeffs.l10 = vec4(0.0);
    shCoeffs.l1p1 = vec4(0.0);
    shCoeffs.l2m2 = vec4(0.0);
    shCoeffs.l2m1 = vec4(0.0);
    shCoeffs.l20 = vec4(0.0);
    shCoeffs.l2p1 = vec4(0.0);
    shCoeffs.l2p2 = vec4(0.0);

    // 用于生成随机数的种子
    uint rngState = gl_GlobalInvocationID.x;

    // 蒙特卡洛积分
    for (int i = 0; i < numSamples; i++) {
        // 生成半球上的随机方向
        // 使用Hammersley序列生成低差异序列
        float u = float(i) / float(numSamples);
        float v = fract(sin(float(i) * 12.9898 + float(rngState) * 78.233) * 43758.5453);

        // 将UV转换为球坐标
        float theta = 2.0 * 3.14159265 * u;  // 方位角 [0, 2π]
        float phi = acos(2.0 * v - 1.0);      // 仰角 [0, π]

        // 球坐标转笛卡尔坐标
        float sinPhi = sin(phi);
        vec3 dir = vec3(
            sinPhi * cos(theta),
            sinPhi * sin(theta),
            cos(phi)
        );

        // 从环境贴图采样
        vec3 color = texture(envMap, dir).rgb;

        // 计算每个SH基函数的权重
        float weight = 4.0 * 3.14159265 / float(numSamples);

        // 累加到SH系数
        shCoeffs.l00.rgb += color * shBasis00(dir) * weight;
        shCoeffs.l1m1.rgb += color * shBasis1m1(dir) * weight;
        shCoeffs.l10.rgb += color * shBasis10(dir) * weight;
        shCoeffs.l1p1.rgb += color * shBasis1p1(dir) * weight;
        shCoeffs.l2m2.rgb += color * shBasis2m2(dir) * weight;
        shCoeffs.l2m1.rgb += color * shBasis2m1(dir) * weight;
        shCoeffs.l20.rgb += color * shBasis20(dir) * weight;
        shCoeffs.l2p1.rgb += color * shBasis2p1(dir) * weight;
        shCoeffs.l2p2.rgb += color * shBasis2p2(dir) * weight;
    }

    // 设置alpha通道为1.0
    shCoeffs.l00.a = 1.0;
    shCoeffs.l1m1.a = 1.0;
    shCoeffs.l10.a = 1.0;
    shCoeffs.l1p1.a = 1.0;
    shCoeffs.l2m2.a = 1.0;
    shCoeffs.l2m1.a = 1.0;
    shCoeffs.l20.a = 1.0;
    shCoeffs.l2p1.a = 1.0;
    shCoeffs.l2p2.a = 1.0;
}
